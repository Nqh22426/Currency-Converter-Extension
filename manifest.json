{
  "manifest_version": 3,
  "name": "Currency to VND",
  "version": "1.2.0",
  "description": "Tự động quy đổi giá tiền tệ quốc tế sang VND và hiển thị bên cạnh giá gốc, hỗ trợ thêm tính năng quy đổi tiền tệ thủ công.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://open.er-api.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Currency to VND",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}